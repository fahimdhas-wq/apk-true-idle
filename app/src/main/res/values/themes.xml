<resources>
    <!--
      Bar colours are intentionally not set here: MainActivity calls enableEdgeToEdge(), which
      overrides android:statusBarColor / android:navigationBarColor, and the Compose theme paints
      BgDark (0xFF000000) behind the bars.
    -->
    <style name="Theme.TrueIdle" parent="android:Theme.Material.NoActionBar" />
</resources>
